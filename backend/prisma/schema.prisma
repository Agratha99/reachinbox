datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   Sender[]
  campaigns Campaign[]
  auditLogs AuditLog[]
  leadLists LeadList[]
  templates Template[]
}

model Sender {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  displayName String
  smtpHost    String?
  smtpPort    Int?
  smtpUser    String?
  smtpPass    String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emailJobs EmailJob[]
  campaigns Campaign[]

  @@index([userId])
  @@index([email])
}

model Campaign {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId        String
  sender          Sender   @relation(fields: [senderId], references: [id])
  name            String
  subject         String
  body            String
  status          String   @default("SCHEDULED")
  startTime       DateTime @default(now())
  delayMs         Int      @default(2000)
  hourlyLimit     Int      @default(200)
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emailJobs EmailJob[]

  @@index([userId])
  @@index([senderId])
  @@index([status])
}

model EmailJob {
  id             String    @id @default(uuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId       String
  sender         Sender    @relation(fields: [senderId], references: [id])
  recipient      String
  recipientName  String?
  subject        String
  body           String
  status         JobStatus @default(SCHEDULED)
  scheduledAt    DateTime
  sentAt         DateTime?
  processingAt   DateTime?
  lockedUntil    DateTime?
  attempts       Int       @default(0)
  bullmqJobId    String?
  idempotencyKey String    @unique
  messageId      String?
  previewUrl     String?
  errorMessage   String?

  // Tracking metrics
  openCount      Int       @default(0)
  openedAt       DateTime?
  clickCount     Int       @default(0)
  clickedAt      DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([campaignId])
  @@index([senderId])
  @@index([recipient])
  @@index([idempotencyKey])
}

model LeadList {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  leadsCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  leads       LeadItem[]

  @@index([userId])
}

model LeadItem {
  id         String   @id @default(uuid())
  listId     String
  leadList   LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  company    String?
  customData String?
  createdAt  DateTime @default(now())

  @@index([listId])
  @@index([email])
}

model Template {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String
  category  String?  @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UnsubscribedRecipient {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}
